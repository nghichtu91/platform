{% set etcdvalue = item.value %}

# etcd
etcd_endpoint = {{etcdvalue.etcd_endpoint}}
etcd_devops = "{{etcdvalue.etcd_root_devops}}" # 运维目录
etcd_server = "{{etcdvalue.etcd_root_server}}" # 服务器目录

serverid = "{{ etcdvalue.serverid }}"

#聊天服大区先留着，可以作为海外，国内的区分
gid = {{ etcdvalue.gid }}

ChatxRedisAddr="{{etcdvalue.ChatxRedisAddr}}"
ChatxRedisDb="{{etcdvalue.ChatxRedisDb}}"
ChatxRedisDbPwd="{{etcdvalue.ChatxRedisDbPwd}}"

internalip="{{etcdvalue.CloudIP}}"
NatsUrl= "{{etcdvalue.NatsUrl}}"

# gm server url
gmserver= "http://127.0.0.1:8808"

# logic server config ---> client is comet
[RPCServer]
Network = "tcp"
#Addr = ":10002"
Timeout = 1
IdleTimeout = 60
MaxLifeTime = 7200
ForceCloseWait = 20
KeepAliveInterval = 60
KeepAliveTimeout = 20

# 私聊消息最大保存数量
[Personal]
MaxPersonSaveCount  = 200
# 私聊字段最长保存时间14天
MaxPersonKeySaveTime = 1204800

# room可能需要按类型来配置
[Room]
MaxRoomSaveCount  = 100
# 房间最长保存时间7天
MaxRoomKeySaveTime = 604800

[Auth]
MaxAuthTimeOut = 86400

[GmServer]
ConnectTimeout = 10
ReadWriteTimeout = 10

